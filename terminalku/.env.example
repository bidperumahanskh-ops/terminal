# Terminalku — konfigurasi (semua bisa di-override env)
# Salin ke .env lalu isi. JANGAN commit .env.

# Server
PORT=3000
HOST=0.0.0.0

# Keamanan
SESSION_SECRET=ganti-ini-dengan-string-acak-panjang
SESSION_TTL_HOURS=8
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MIN=15

# Akses file (root yang boleh dilihat via web)
# Kosongkan = seluruh filesystem (hati-hati). Contoh: /home/adminsipuruh
FS_ROOT=

# Path sensitif yang diblokir (dipisah koma)
FS_BLOCK=/root,.ssh,.env,id_rsa,id_ed25519,node_modules,.git

# Terminal sandbox
TERM_SHELL=/bin/bash
TERM_USER=node
TERM_CWD=/home/node
TERM_MAX_SESSIONS=5

# Database
DB_PATH=./data/terminalku.db

# User admin awal (dibuat saat pertama kali DB kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-ini-juga
ADMIN_ROLE=admin